---
import BaseRedesign from "@/layouts/BaseRedesign.astro";
import SiteNav from "@/components/SiteNav.astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Pagination from "@/components/Pagination.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import readingTime from "@/lib/utils/readingTime";
import { categoryMetadata } from "@/lib/categoryMetadata";
import { slugify } from "@/lib/utils/textConverter";
import config from "@/config/config.json";

const { blog_folder, pagination } = config.settings;
const allPosts    = await getSinglePage(blog_folder);
const sortedPosts = sortByDate(allPosts);
const postCount   = sortedPosts.length;
const totalPages  = Math.ceil(postCount / pagination);

// Page 1 slice
const currentPosts = sortedPosts.slice(0, pagination);

const writingSince = new Date(config.settings.writing_since);
const yearsWriting = Math.floor(
  (new Date().getTime() - writingSince.getTime()) / (365.25 * 24 * 60 * 60 * 1000)
);

// Category counts from ALL posts for accurate ribbon numbers
const categoryCounts: Record<string, number> = {};
for (const post of sortedPosts) {
  const cat = post.data.category;
  if (cat) categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
}

const categories = [
  { key: "all", name: "All", count: postCount },
  ...Object.entries(categoryMetadata)
    .filter(([key]) => categoryCounts[key])
    .map(([key, meta]) => ({ key, name: meta.name, count: categoryCounts[key]! })),
];

const getReadTime = (post: typeof sortedPosts[0]) => {
  try { return readingTime((post as any).body ?? ""); } catch { return ""; }
};
---

<BaseRedesign title="Blog — Villoro" description="Data-engineering notes on Python, dbt, AWS, and the quiet habits that keep pipelines boring.">
  <div class="bl">

    <!-- ══════════════════════ NAV ════════════════════════ -->
    <SiteNav />

    <!-- ══════════════════════ HERO ═══════════════════════ -->
    <section class="bl-hero">
      <span class="bl-hero__bg" aria-hidden="true">blog.</span>
      <div class="bl-wrap">

        <nav class="bl-crumb" aria-label="breadcrumb">
          <a href="/" class="bl-crumb__link">Villoro</a>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          <span class="bl-crumb__current">Blog</span>
        </nav>

        <h1 class="bl-hero__h1">
          Notes from<br />
          <span class="bl-blue">production.</span>
        </h1>

        <div class="bl-hero__row">
          <p class="bl-hero__lede">
            {yearsWriting} years of data-engineering notes — Python, dbt, AWS,
            and the quiet habits that keep pipelines boring. No filler, no
            sponsored posts, no SEO bait.
          </p>
          <div class="bl-hero__count">
            <div class="bl-hero__count-num">
              <span class="bl-hero__count-bg" aria-hidden="true"></span>
              <span class="bl-hero__count-val">{postCount}</span>
            </div>
            <div class="bl-hero__count-label">posts · updated monthly</div>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════════════ CATEGORY RIBBON ════════════════ -->
    <div class="bl-cats">
      <div class="bl-wrap bl-cats__flex">
        <span class="bl-cats__label">Category</span>
        <div class="bl-cats__chips">
          {categories.map((cat, i) => (
            cat.key === "all"
              ? <a href="/blog" class="bl-chip is-active">{cat.name}<span class="bl-chip__count">{cat.count}</span></a>
              : <a href={`/categories/${slugify(cat.key)}`} class="bl-chip">{cat.name}<span class="bl-chip__count">{cat.count}</span></a>
          ))}
        </div>
      </div>
    </div>

    <!-- ════════════════════ POSTS GRID ═══════════════════ -->
    <section class="bl-grid-sec">
      <div class="bl-wrap">

        <div class="bl-grid-head">
          <h2 class="bl-grid-title">All posts</h2>
          <span class="bl-grid-meta">Sorted by date · newest first</span>
        </div>

        <div class="bl-grid">
          {currentPosts.map((post, i) => (
            <PostCard
              post={post}
              variant="small"
              readTime={getReadTime(post)}
              loading={i < 6 ? "eager" : "lazy"}
            />
          ))}
        </div>

        <div class="bl-pagination">
          <Pagination section={blog_folder} currentPage={1} totalPages={totalPages} />
        </div>

      </div>
    </section>

    <!-- ══════════════════════ FOOTER ═════════════════════ -->
    <SiteFooter />

  </div>
</BaseRedesign>

<style>
  .bl {
    background: var(--color-grey-50);
    color: var(--color-navy-900);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
    --container-px: 64px;
  }

  .bl-wrap {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 var(--container-px);
  }

  .bl-blue { color: var(--color-blue-500); }

  /* ── Hero ─────────────────────────────────────────────────────────── */

  .bl-hero {
    position: relative;
    padding: 40px 0 48px;
    overflow: hidden;
  }

  .bl-hero__bg {
    position: absolute;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 320px;
    color: rgba(58, 118, 255, 0.05);
    letter-spacing: -0.06em;
    bottom: -80px;
    right: -30px;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .bl-crumb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-grey-500);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .bl-crumb__link {
    color: var(--color-grey-500);
    text-decoration: none;
    transition: color 0.15s;
  }
  .bl-crumb__link:hover { color: var(--color-blue-500); }
  .bl-crumb__current    { color: var(--color-blue-500); }

  .bl-hero__h1 {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(3.5rem, 7vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    margin: 0;
    position: relative;
    z-index: 2;
    color: var(--color-navy-900);
  }

  .bl-hero__row {
    margin-top: 32px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    position: relative;
    z-index: 2;
  }

  .bl-hero__lede {
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-navy-900);
    max-width: 620px;
    margin: 0;
    opacity: 0.75;
  }

  .bl-hero__count {
    font-family: var(--font-ui);
    text-align: right;
    flex-shrink: 0;
  }

  .bl-hero__count-num {
    font-size: 72px;
    font-weight: 700;
    color: var(--color-navy-900);
    line-height: 0.9;
    letter-spacing: -0.03em;
    position: relative;
    display: inline-block;
  }

  .bl-hero__count-bg {
    position: absolute;
    inset: -2px -10px;
    background: var(--color-yellow-400);
    border-radius: 6px;
    z-index: 0;
  }

  .bl-hero__count-val {
    position: relative;
    z-index: 1;
  }

  .bl-hero__count-label {
    font-size: 13px;
    color: var(--color-grey-500);
    margin-top: 8px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* ── Category ribbon ──────────────────────────────────────────────── */

  .bl-cats {
    background: var(--color-blue-500);
    position: sticky;
    top: 74px;
    z-index: 20;
    box-shadow: 0 8px 24px -12px rgba(58, 118, 255, 0.4);
  }

  .bl-cats__flex {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    flex-wrap: wrap;
  }

  .bl-cats__label {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    flex-shrink: 0;
  }

  .bl-cats__chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .bl-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: none;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
    white-space: nowrap;
  }

  .bl-chip:hover     { background: rgba(255, 255, 255, 0.22); }
  .bl-chip.is-active { background: #fff; color: var(--color-navy-900); }

  .bl-chip__count {
    font-size: 11px;
    font-weight: 700;
    opacity: 0.65;
  }
  .bl-chip.is-active .bl-chip__count { opacity: 0.45; }

  /* ── Posts grid ───────────────────────────────────────────────────── */

  .bl-grid-sec {
    padding: 56px 0 80px;
  }

  .bl-grid-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 36px;
    font-family: var(--font-ui);
    flex-wrap: wrap;
    gap: 8px;
  }

  .bl-grid-title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-navy-900);
  }

  .bl-grid-meta {
    font-size: 14px;
    color: var(--color-grey-500);
    font-weight: 500;
  }

  .bl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .bl-empty {
    text-align: center;
    padding: 64px 0;
    color: var(--color-grey-500);
    font-family: var(--font-ui);
    font-size: 16px;
  }

  .bl-pagination {
    margin-top: 48px;
  }

  /* ── Responsive ───────────────────────────────────────────────────── */

  @media (max-width: 1023px) {
    .bl { --container-px: 32px; }
    .bl-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 767px) {
    .bl { --container-px: 20px; }
    .bl-hero__h1  { font-size: clamp(2.5rem, 10vw, 56px); }
    .bl-hero__row { flex-direction: column; align-items: flex-start; gap: 24px; }
    .bl-hero__count { text-align: left; }
    .bl-hero__bg  { display: none; }
    .bl-cats      { position: static; }
    .bl-grid      { grid-template-columns: 1fr; }
  }
</style>
