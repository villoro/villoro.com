---
import BlogListingLayout from "@/layouts/BlogListingLayout.astro";
import { getPublishedPosts } from "@/lib/posts";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { getCategoryRibbonData, getYearsWriting } from "@/lib/listingData";
import config from "@/config/config.json";
import { getBlogListingCopy } from "@/lib/listingCopy";

const { blog_folder, pagination } = config.settings;
const allPosts    = await getPublishedPosts();
const sorted      = sortByDate(allPosts);
const totalPages  = Math.ceil(sorted.length / pagination);
const currentPosts = sorted.slice(0, pagination);

const { postCount, categories } = getCategoryRibbonData(sorted);
const yearsWriting = getYearsWriting();

const bi = await getBlogListingCopy();
---

<BlogListingLayout
  title={bi.meta_title ?? bi.title}
  description={bi.description}
  breadcrumbs={[{ href: "/", label: "Villoro" }, { label: "Blog" }]}
  postCount={postCount}
  yearsWriting={yearsWriting}
  heroH1={bi.hero.h1}
  heroLede={bi.hero.lede}
  heroCountLabel={bi.hero.count_label}
  categories={categories}
  activeCategory="all"
  sectionTitle={bi.section.title}
  sectionMeta={bi.section.meta}
  currentPosts={currentPosts}
  currentPage={1}
  totalPages={totalPages}
  paginationSection={blog_folder}
/>
