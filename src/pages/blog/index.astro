---
import BlogListingLayout from "@/layouts/BlogListingLayout.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { getCategoryRibbonData, getYearsWriting } from "@/lib/listingData";
import config from "@/config/config.json";

const { blog_folder, pagination } = config.settings;
const allPosts    = await getSinglePage(blog_folder);
const sorted      = sortByDate(allPosts);
const totalPages  = Math.ceil(sorted.length / pagination);
const currentPosts = sorted.slice(0, pagination);

const { postCount, categories } = getCategoryRibbonData(sorted);
const yearsWriting = getYearsWriting();
---

<BlogListingLayout
  title="Blog — Villoro"
  description="Data-engineering notes on Python, dbt, AWS, and the quiet habits that keep pipelines boring."
  breadcrumbs={[{ href: "/", label: "Villoro" }, { label: "Blog" }]}
  postCount={postCount}
  yearsWriting={yearsWriting}
  categories={categories}
  activeCategory="all"
  sectionTitle="All posts"
  sectionMeta="Sorted by date · newest first"
  currentPosts={currentPosts}
  currentPage={1}
  totalPages={totalPages}
  paginationSection={blog_folder}
/>
