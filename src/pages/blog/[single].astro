---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { render } from "astro:content";
import { getPostsToBuild, getPublishedPosts, postSlug } from "@/lib/posts";
import similarItems from "@/lib/utils/similarItems";
import { readingTimeForPost } from "@/lib/utils/readingTime";
import dateFormat from "@/lib/utils/dateFormat";
import { categoryMetadata } from "@/lib/categoryMetadata";
import config from "@/config/config.json";
import { withTrailingSlash } from "@/lib/utils/url";
import type { TocItem } from "@/components/ArticleTOC.astro";

export async function getStaticPaths() {
  const items = await getPostsToBuild();
  return items.map((post) => ({
    params: { single: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { blog_folder, similar_items_length } = config.settings;
const {
  title,
  description,
  image,
  date,
  updated_date: updatedDate,
  tags = [],
  category,
} = post.data;
const slug = postSlug(post);
const canonical = withTrailingSlash(
  `${config.site.base_url}${Astro.url.pathname}`,
);

const posts = await getPublishedPosts();
const similarPosts = similarItems(post, posts, similar_items_length);
const { Content, headings } = await render(post);

const catMeta = categoryMetadata[category];
const catName = catMeta.name;
const catColor = catMeta.color;

// Build numbered, hierarchical TOC (depth 2 + 3)
const toc: TocItem[] = [];
let h2Count = 0;
let h3Count = 0;
for (const h of headings) {
  if (h.depth === 2) {
    h2Count += 1;
    h3Count = 0;
    toc.push({ num: `${h2Count}.`, text: h.text, slug: h.slug, depth: 2 });
  } else if (h.depth === 3 && h2Count > 0) {
    h3Count += 1;
    toc.push({
      num: `${h2Count}.${h3Count}.`,
      text: h.text,
      slug: h.slug,
      depth: 3,
    });
  }
}

const readTime = readingTimeForPost(post);
const formattedDate = date ? dateFormat(date, "MMMM d, yyyy") : "";
const formattedUpdatedDate = updatedDate
  ? dateFormat(updatedDate, "MMMM d, yyyy")
  : "";
const publishedTime = date ? new Date(date).toISOString() : undefined;
const modifiedTime = updatedDate
  ? new Date(updatedDate).toISOString()
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date ? new Date(date).toISOString() : undefined,
  dateModified: updatedDate
    ? new Date(updatedDate).toISOString()
    : date
      ? new Date(date).toISOString()
      : undefined,
  author: {
    "@type": "Person",
    name: post.data.author,
  },
  mainEntityOfPage: canonical,
  keywords: tags.join(", ") || undefined,
};
---

<ArticleLayout
  title={title}
  meta_title={post.data.meta_title}
  description={description}
  image={image}
  canonical={canonical}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={post.data.author}
  jsonLd={jsonLd}
  category={category}
  catName={catName}
  catColor={catColor}
  tags={tags}
  draft={post.data.draft}
  formattedDate={formattedDate}
  formattedUpdatedDate={formattedUpdatedDate}
  readTime={readTime}
  slug={slug}
  blogFolder={blog_folder}
  toc={toc}
  relatedPosts={similarPosts}
>
  <Content />
</ArticleLayout>
