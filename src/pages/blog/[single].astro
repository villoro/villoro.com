---
/**
 * Single blog post — redesign 3.0.
 *
 * Layout:
 *   Hero (16:9 image + gradient + breadcrumb + category + title + tags + author meta)
 *   Article (260px sticky TOC + 1fr body, numbered multi-level TOC)
 *   End-of-post CTA strip (Buy me a coffee + Subscribe) + share + comments
 *   Related posts (3-col grid)
 *
 * Reuses existing IntersectionObserver scroll-spy against `.article-content section`
 * (sections are injected by @hbsnow/rehype-sectionize).
 */
import BaseRedesign from "@/layouts/BaseRedesign.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PostCard from "@/components/PostCard.astro";
import GiscusComments from "@/components/GiscusComments.astro";
import ImageMod from "@/components/ImageMod.astro";
import { render } from "astro:content";
import { getSinglePage } from "@/lib/contentParser.astro";
import similarItems from "@/lib/utils/similarItems";
import readingTime from "@/lib/utils/readingTime";
import dateFormat from "@/lib/utils/dateFormat";
import { categoryMetadata } from "@/lib/categoryMetadata";
import { humanize, slugify } from "@/lib/utils/textConverter";
import config from "@/config/config.json";

export async function getStaticPaths() {
  const { blog_folder } = config.settings;
  const item = await getSinglePage(blog_folder);
  return item.map((post) => ({
    params: { single: post.data.slug || post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { blog_folder, similar_items_length } = config.settings;
const { title, description, image, date, tags = [], category } = post.data;
const slug = post.data.slug || post.id;
const canonical = `${config.site.base_url}${Astro.url.pathname}`;

const posts = await getSinglePage(blog_folder);
const similarPosts = similarItems(post, posts, similar_items_length);
const { Content, headings } = await render(post);

const catMeta  = categoryMetadata[category] || { name: humanize(category) };
const catName  = catMeta.name;
const catColor = catMeta.color ?? "var(--color-grey-500)";
const catSlug  = slugify(category);

// ───── Build numbered, hierarchical TOC (depth 2 + 3) ─────
type TocItem = { num: string; text: string; slug: string; depth: 2 | 3 };
const toc: TocItem[] = [];
let h2Count = 0;
let h3Count = 0;
for (const h of headings) {
  if (h.depth === 2) {
    h2Count += 1;
    h3Count = 0;
    toc.push({ num: `${h2Count}.`, text: h.text, slug: h.slug, depth: 2 });
  } else if (h.depth === 3 && h2Count > 0) {
    h3Count += 1;
    toc.push({ num: `${h2Count}.${h3Count}.`, text: h.text, slug: h.slug, depth: 3 });
  }
}

const readTime = (() => {
  try { return readingTime((post as any).body ?? ""); } catch { return ""; }
})();

const formattedDate = date ? dateFormat(date, "MMMM d, yyyy") : "";

// Build related-posts URL helpers are handled by PostCard.
---

<BaseRedesign
  title={title}
  meta_title={post.data.meta_title}
  description={description}
  image={image}
  canonical={canonical}
>
  <div class="ps">
    <SiteNav />

    <!-- ═══════════════════════ HERO ════════════════════════ -->
    <section class="ps-hero">
      {image && (
        <ImageMod
          src={image}
          alt={title}
          width={1920}
          height={1080}
          format="webp"
          loading="eager"
          class="ps-hero__img"
        />
      )}
      <div class="ps-hero__overlay"></div>

      <nav class="ps-hero__crumb" aria-label="breadcrumb">
        <a href="/" class="ps-hero__crumb-link">Villoro</a>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        <a href="/blog" class="ps-hero__crumb-link">Blog</a>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        <a href={`/categories/${catSlug}`} class="ps-hero__crumb-link">{catName}</a>
      </nav>

      <div class="ps-hero__body">
        <span class="ps-hero__cat" style={`background: ${catColor}`}>{catName}</span>
        <h1 class="ps-hero__title">{title}</h1>

        {tags.length > 0 && (
          <div class="ps-hero__tags">
            {tags.map((t: string) => (
              <a href={`/tags/${slugify(t)}`} class="ps-hero__tag">#{t}</a>
            ))}
          </div>
        )}

        <div class="ps-hero__meta">
          <span class="ps-hero__author">Arnau Villoro</span>
          {formattedDate && <>
            <span class="ps-hero__dot">·</span>
            <span>{formattedDate}</span>
          </>}
          {readTime && <>
            <span class="ps-hero__dot">·</span>
            <span>{readTime}</span>
          </>}
        </div>
      </div>
    </section>

    <!-- ═══════════════════ ARTICLE BODY ═════════════════════ -->
    <section class="ps-article">

      <!-- Numbered multi-level TOC -->
      {toc.length > 0 && (
        <aside class="ps-toc-wrap" id="toc-container">
          <div class="ps-toc-label">Table of contents</div>
          <nav class="toc ps-toc" aria-label="table of contents">
            <ul>
              {toc.map((item) => (
                <li class={`ps-toc-item ps-toc-item--d${item.depth}`}>
                  <a href={`#${item.slug}`}>
                    <span class="ps-toc-num">{item.num}</span>
                    <span class="ps-toc-text">{item.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}

      <article class="ps-body">
        <div class="article-content">
          <Content />
        </div>

        <!-- CTA strip: Buy me a coffee + Subscribe -->
        <div class="ps-cta">
          <div class="ps-cta__text">
            <div class="ps-cta__kicker">Enjoyed this?</div>
            <div class="ps-cta__question">Support the blog or get the next one in your inbox.</div>
          </div>
          <div class="ps-cta__buttons">
            <a href="https://www.buymeacoffee.com/villoro" target="_blank" rel="noopener noreferrer" class="ps-cta__coffee">
              <span aria-hidden="true">☕</span> Buy me a coffee
            </a>
            <a href={config.subscribe.link} target="_blank" rel="noopener noreferrer" class="ps-cta__subscribe">
              {config.subscribe.title}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Share row -->
        <div class="ps-share">
          <span class="ps-share__label">Share this post</span>
          <div class="ps-share__btns">
            <button type="button" class="ps-share__btn ps-share__btn--dark" aria-label="Copy link" data-ps-copy>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
            <a class="ps-share__btn ps-share__btn--blue" aria-label="Share on LinkedIn"
               href={`https://www.linkedin.com/shareArticle?mini=true&url=${config.site.base_url}/${blog_folder}/${slug}&title=${encodeURIComponent(title)}`}
               target="_blank" rel="noopener noreferrer">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>
            </a>
            <a class="ps-share__btn ps-share__btn--blue" aria-label="Share on Twitter"
               href={`https://twitter.com/intent/tweet/?text=${encodeURIComponent(title)}&url=${config.site.base_url}/${blog_folder}/${slug}`}
               target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a class="ps-share__btn ps-share__btn--blue" aria-label="Share by email"
               href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${config.site.base_url}/${blog_folder}/${slug}`)}`}>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </a>
          </div>
        </div>

        <!-- Comments (Giscus) -->
        <div class="ps-comments">
          <GiscusComments />
        </div>
      </article>
    </section>

    <!-- ═══════════════════ RELATED POSTS ════════════════════ -->
    {similarPosts.length > 0 && (
      <section class="ps-related">
        <div class="ps-related__inner">
          <div class="ps-related__head">
            <h2 class="ps-related__h">Related posts</h2>
            <a href="/blog" class="ps-related__all">All posts →</a>
          </div>
          <div class="ps-related__grid">
            {similarPosts.map((p) => (
              <PostCard post={p} variant="small" loading="lazy" />
            ))}
          </div>
        </div>
      </section>
    )}

    <SiteFooter />
  </div>
</BaseRedesign>

<!-- TOC scroll-spy (reuses existing pattern) -->
<script>
  function setupTOC() {
    const tocContainer = document.querySelector('#toc-container');
    if (!tocContainer) return;

    const nav = document.querySelector('.sitenav');
    const headerHeight = (nav as HTMLElement | null)?.offsetHeight ?? 74;
    const extraMargin = 24;

    const isLargeScreen = () => window.innerWidth >= 1024;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const heading = entry.target.querySelector('h2, h3, h4, h5');
        if (!heading) return;
        const id = heading.getAttribute('id');
        if (!id) return;
        const links = document.querySelectorAll(`nav.toc li a[href="#${id}"]`);
        links.forEach((link) => {
          if (entry.isIntersecting) {
            link.classList.add('active');
            link.closest('li')?.classList.add('is-active');
          } else {
            link.classList.remove('active');
            link.closest('li')?.classList.remove('is-active');
          }
        });
      });
    }, {
      rootMargin: `-${headerHeight}px 0px -60% 0px`,
      threshold: 0.01,
    });

    if (isLargeScreen()) {
      document.querySelectorAll('.article-content section').forEach((s) => observer.observe(s));
    }

    // Smooth-scroll offset: account for sticky nav
    const handleClick = (event: Event) => {
      const target = event.target as HTMLElement;
      const anchor = target.closest('a') as HTMLAnchorElement | null;
      if (!anchor) return;
      const href = anchor.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      const id = href.substring(1);
      const el = document.getElementById(id);
      if (!el) return;
      event.preventDefault();
      window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - headerHeight - extraMargin, behavior: 'smooth' });
      history.pushState(null, '', `#${id}`);
    };
    document.querySelectorAll('nav.toc').forEach((n) => n.addEventListener('click', handleClick));

    // Copy-link button
    const copyBtn = document.querySelector('[data-ps-copy]');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          (copyBtn as HTMLElement).style.background = 'var(--color-blue-500)';
          setTimeout(() => { (copyBtn as HTMLElement).style.background = ''; }, 800);
        } catch {}
      });
    }
  }

  document.addEventListener('astro:page-load', setupTOC);
  document.addEventListener('astro:after-swap', setupTOC);
</script>

<!-- ═════════════ Article content styling (global) ═════════════ -->
<!-- Global because MDX / rehype content lives outside the scoped CSS graph -->
<style is:global>
  /* ── Inline code ─────────────────────────────────────── */
  .ps-body .article-content :not(pre) > code {
    background: var(--color-grey-100);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-navy-900);
  }

  /* ── Shiki code blocks: dark navy with yellow label ─── */
  .ps-body .article-content pre {
    background: #0e1330 !important;
    color: #e4e7f5;
    padding: 22px 26px;
    border-radius: 0 0 12px 12px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }
  .ps-body .article-content pre code {
    background: transparent !important;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .ps-body .article-content .astro-code,
  .ps-body .article-content figure.expressive-code,
  .ps-body .article-content pre {
    margin: 24px 0;
    border-radius: 12px;
    border: 1px solid #0b1026;
    overflow: hidden;
  }

  /* ── Paragraphs, lists ───────────────────────────────── */
  .ps-body .article-content { font-size: 17px; line-height: 1.75; color: #222437; }
  .ps-body .article-content > p:first-of-type { font-size: 20px; color: var(--color-ink-800); margin-bottom: 32px; }
  .ps-body .article-content p  { margin: 0 0 22px; }
  .ps-body .article-content ul,
  .ps-body .article-content ol { margin: 0 0 24px 1.5rem; padding: 0; }
  .ps-body .article-content li { margin: 0 0 6px; }
  .ps-body .article-content strong { color: var(--color-navy-900); font-weight: 700; }
  .ps-body .article-content em { font-style: italic; }
  .ps-body .article-content hr {
    border: none;
    border-top: 1px solid var(--color-grey-100);
    margin: 40px 0;
  }

  /* ── Headings with auto-numbering ────────────────────── */
  .ps-body .article-content { counter-reset: ps-h2; }
  .ps-body .article-content h2 {
    counter-increment: ps-h2;
    counter-reset: ps-h3;
    font-family: var(--font-ui);
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 56px 0 20px;
    color: var(--color-navy-900);
    scroll-margin-top: 100px;
  }
  .ps-body .article-content h2::before {
    content: counter(ps-h2) ". ";
    color: var(--color-blue-500);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.75em;
    margin-right: 10px;
  }
  .ps-body .article-content h3 {
    counter-increment: ps-h3;
    font-family: var(--font-ui);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 40px 0 14px;
    color: var(--color-navy-900);
    scroll-margin-top: 100px;
  }
  .ps-body .article-content h3::before {
    content: counter(ps-h2) "." counter(ps-h3) " ";
    color: var(--color-blue-500);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8em;
    margin-right: 8px;
  }
  .ps-body .article-content h4 {
    font-family: var(--font-ui);
    font-size: 18px;
    font-weight: 700;
    margin: 28px 0 10px;
    color: var(--color-navy-900);
    scroll-margin-top: 100px;
  }

  /* ── Links (non-callout) ─────────────────────────────── */
  .ps-body .article-content a {
    color: var(--color-blue-500);
    text-decoration: none;
    border-bottom: 1px solid rgba(58, 118, 255, 0.3);
    transition: border-color 0.15s;
  }
  .ps-body .article-content a:hover { border-bottom-color: var(--color-blue-500); }

  /* ── Images (block-level only; excludes icons inside links/callouts) ── */
  .ps-body .article-content > p > img,
  .ps-body .article-content > figure img,
  .ps-body .article-content section > p > img,
  .ps-body .article-content section > figure img {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 24px 0;
  }

  /* ── Blockquotes (fallback; most blockquotes become .notice) ───── */
  .ps-body .article-content blockquote {
    margin: 28px 0;
    padding: 16px 20px;
    background: #eef4ff;
    border-left: 4px solid var(--color-blue-500);
    border-radius: 0 10px 10px 0;
    color: var(--color-ink-800);
  }
  .ps-body .article-content blockquote p { margin: 0 0 8px; }
  .ps-body .article-content blockquote p:last-child { margin: 0; }

  /* ── Callouts (Notice shortcode) ───────────────────────── */
  .ps-body .article-content .notice {
    margin: 24px 0;
    padding: 14px 18px;
    align-items: flex-start;
    gap: 12px;
  }
  .ps-body .article-content .notice > span:first-child {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    margin-top: 2px;
    font-size: 18px;
    line-height: 1;
  }
  .ps-body .article-content .notice > span:last-child { margin-left: 0; }
  .ps-body .article-content .notice p { margin: 0; }
  .ps-body .article-content .notice p + p { margin-top: 8px; }
  .ps-body .article-content .notice img {
    margin: 0;
    border-radius: 2px;
    display: inline-block;
    vertical-align: middle;
  }

  /* ── FancyLink pill (a[role=button]) ───────────────────── */
  .ps-body .article-content a[role="button"] {
    border-bottom: none;
    line-height: 1.4;
    padding: 2px 8px !important;
    vertical-align: baseline;
  }
  .ps-body .article-content a[role="button"] img {
    margin: 0 6px 0 0 !important;
    border-radius: 0;
    display: inline-block;
    vertical-align: middle;
  }

  /* ── Tables ──────────────────────────────────────────── */
  .ps-body .article-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 15px;
  }
  .ps-body .article-content th,
  .ps-body .article-content td {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-grey-100);
  }
  .ps-body .article-content th {
    font-family: var(--font-ui);
    font-weight: 700;
    color: var(--color-navy-900);
    background: var(--color-grey-50);
  }

  /* ── TOC active state ─────────────────────────────────── */
  .ps-toc a.active .ps-toc-text,
  .ps-toc li.is-active > a .ps-toc-text {
    color: var(--color-navy-900);
    font-weight: 700;
  }
  .ps-toc a.active .ps-toc-num,
  .ps-toc li.is-active > a .ps-toc-num {
    color: var(--color-blue-500);
  }
</style>

<style>
  .ps {
    background: var(--color-grey-50);
    color: var(--color-navy-900);
    font-family: var(--font-body);
    line-height: 1.6;
    --container-px: 64px;
  }

  /* ═══════════════════ HERO ═══════════════════════ */
  .ps-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 620px;
    min-height: 420px;
    overflow: hidden;
    color: #fff;
    background: var(--color-navy-900);
  }
  .ps-hero :global(.ps-hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ps-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(11, 16, 38, 0.3) 0%,
      rgba(11, 16, 38, 0.5) 55%,
      rgba(11, 16, 38, 0.92) 100%
    );
  }

  .ps-hero__crumb {
    position: absolute;
    top: 28px;
    left: var(--container-px);
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    z-index: 3;
  }
  .ps-hero__crumb-link {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.15s;
  }
  .ps-hero__crumb-link:hover { color: var(--color-yellow-400); }

  .ps-hero__body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 48px var(--container-px) 56px;
    max-width: 1440px;
    margin: 0 auto;
    z-index: 2;
  }

  .ps-hero__cat {
    display: inline-block;
    color: #fff;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 6px;
    margin-bottom: 18px;
  }

  .ps-hero__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(2.2rem, 5.5vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 1050px;
    text-wrap: balance;
    color: #fff;
  }

  .ps-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .ps-hero__tag {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: #fff;
    padding: 5px 10px;
    background: rgba(255, 255, 255, 0.13);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    backdrop-filter: blur(4px);
    text-decoration: none;
    transition: background 0.15s;
  }
  .ps-hero__tag:hover { background: rgba(255, 255, 255, 0.25); }

  .ps-hero__meta {
    margin-top: 22px;
