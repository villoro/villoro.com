---
import BlogListingLayout from "@/layouts/BlogListingLayout.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { getCategoryRibbonData, getYearsWriting } from "@/lib/listingData";
import config from "@/config/config.json";
import { getCollection } from "astro:content";

const { blog_folder, pagination } = config.settings;

export async function getStaticPaths() {
  const { blog_folder, pagination } = (await import("@/config/config.json")).settings;
  const posts = await getSinglePage(blog_folder);
  const totalPages = Math.ceil(posts.length / pagination);
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { slug: (i + 1).toString() },
  }));
}

const { slug } = Astro.params;
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;

const allPosts    = await getSinglePage(blog_folder);
const sorted      = sortByDate(allPosts);
const totalPages  = Math.ceil(sorted.length / pagination);
const start       = (currentPage - 1) * pagination;
const currentPosts = sorted.slice(start, start + pagination);

const { postCount, categories } = getCategoryRibbonData(sorted);
const yearsWriting = getYearsWriting();

const allBlogEntries = await getCollection("blog");
const bi = allBlogEntries.find((e) => e.id === "-index")!.data;
---

<BlogListingLayout
  title={`Blog — Page ${currentPage} — Villoro`}
  description={bi.description}
  breadcrumbs={[
    { href: "/",     label: "Villoro" },
    { href: "/blog", label: "Blog" },
    { label: `Page ${currentPage}` },
  ]}
  postCount={postCount}
  yearsWriting={yearsWriting}
  heroH1={bi.hero?.h1}
  heroLede={bi.hero?.lede}
  heroCountLabel={bi.hero?.count_label}
  categories={categories}
  activeCategory="all"
  sectionTitle={bi.section?.title}
  sectionMeta={`Page ${currentPage} of ${totalPages} · newest first`}
  currentPosts={currentPosts}
  currentPage={currentPage}
  totalPages={totalPages}
  paginationSection={blog_folder}
/>
