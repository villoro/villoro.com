---
import BlogListingLayout from "@/layouts/BlogListingLayout.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { slugify } from "@/lib/utils/textConverter";
import config from "@/config/config.json";

const { blog_folder, pagination } = config.settings;

export async function getStaticPaths() {
  const { blog_folder, pagination } = (await import("@/config/config.json")).settings;
  const tags = await getTaxonomy(blog_folder, "tags");
  const paths = [];
  for (const tag of tags) {
    const items = await getSinglePage(blog_folder);
    const filtered = taxonomyFilter(items, "tags", tag);
    const totalPages = Math.ceil(filtered.length / pagination);
    for (let i = 1; i <= totalPages; i++) {
      paths.push({ params: { tag, slug: i.toString() } });
    }
  }
  return paths;
}

const { tag, slug } = Astro.params;
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;

const items = await getSinglePage(blog_folder);

let originalTag = tag!;
const normalizedTag = tag!.toLowerCase();
const filtered = items.filter((item) => {
  const itemTags = item.data.tags;
  if (itemTags?.some((t: string) => slugify(t).toLowerCase() === normalizedTag)) {
    const match = itemTags.find((t: string) => slugify(t).toLowerCase() === normalizedTag);
    if (match) originalTag = match;
    return true;
  }
  return false;
});

const sortedPosts  = sortByDate(filtered);
const totalPages   = Math.ceil(sortedPosts.length / pagination);
const start        = (currentPage - 1) * pagination;
const currentPosts = sortedPosts.slice(start, start + pagination);
---

<BlogListingLayout
  title={`Tag: ${originalTag} — Page ${currentPage} — Villoro`}
  description={`All posts tagged with ${originalTag}.`}
  breadcrumbs={[
    { href: "/",           label: "Villoro" },
    { href: "/blog",       label: "Blog" },
    { href: `/tags/${tag}`, label: `#${originalTag}` },
    { label: `Page ${currentPage}` },
  ]}
  heroVariant="simple"
  simpleH1="Tag:"
  simpleAccent={`#${originalTag}`}
  simpleLede={`Page ${currentPage} of ${totalPages} · ${sortedPosts.length} posts.`}
  sectionTitle={`#${originalTag}`}
  sectionMeta={`Page ${currentPage} of ${totalPages} · newest first`}
  currentPosts={currentPosts}
  currentPage={currentPage}
  totalPages={totalPages}
  paginationSection={`tags/${tag}`}
/>
