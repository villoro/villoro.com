---
import BaseRedesign from "@/layouts/BaseRedesign.astro";
import SiteNav from "@/components/SiteNav.astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import IconArrow from "@/components/IconArrow.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { readingTimeForPost } from "@/lib/utils/readingTime";
import config from "@/config/config.json";
import { getCollection } from "astro:content";

// ---- Content ----
const [homepageEntry] = await getCollection("homepage");
const hp = homepageEntry.data;

// ---- Data ----
const { blog_folder } = config.settings;
const posts = await getSinglePage(blog_folder);
const sortedPosts = sortByDate(posts);

const latestPost   = sortedPosts[0];
const featuredPost = latestPost;
const gridPosts    = sortedPosts.filter(p => p !== featuredPost).slice(0, 6);
const heroPost     = sortedPosts.find(p => p.data.highlight);

// Stats — all derived at build time, no magic constants
const postCount    = sortedPosts.length;

const today = new Date();

// Years writing: from config.settings.writing_since to today
const writingSince  = new Date(config.settings.writing_since);
const yearsWriting  = Math.floor(
  (today.getTime() - writingSince.getTime()) / (365.25 * 24 * 60 * 60 * 1000)
);

// Days since latest non-draft post
const latestDate = latestPost?.data?.date ? new Date(latestPost.data.date) : today;
const daysAgo    = Math.max(0, Math.round((today.getTime() - latestDate.getTime()) / 86_400_000));

const getReadTime = readingTimeForPost;

---

<BaseRedesign title={hp.meta.title}>
  <div class="hp">

    <!-- ═══════════════════════ NAV ═══════════════════════ -->
    <SiteNav />

    <!-- ═══════════════════════ HERO ══════════════════════ -->
    <section class="hp-hero">
      <!-- faint "villoro." watermark -->
      <span class="hp-hero__watermark" aria-hidden="true">villoro.</span>

      <div class="hp-wrap">
      <div class="hp-hero__grid">
        <!-- Left column -->
        <div class="hp-hero__left">
          <!-- Headline -->
          <h1 class="hp-hero__h1">
            {hp.hero.h1_lines[0].split(' ')[0]} <span class="hp-blue">{hp.hero.h1_lines[0].split(' ').slice(1).join(' ')}</span><br />
            {hp.hero.h1_lines[1].split(' ')[0]} <span class="hp-yellow-chip">{hp.hero.h1_lines[1].split(' ').slice(1).join(' ')}</span><br />
            {hp.hero.h1_lines[2]}
          </h1>

          <!-- Lede -->
          <p class="hp-hero__lede" set:html={hp.hero.lede.replace('{years}', String(yearsWriting)).replace('{posts}', String(postCount))} />

          <!-- CTAs -->
          <div class="hp-hero__ctas">
            <a href={`/${blog_folder}`} class="hp-btn hp-btn--blue">
              {hp.hero.cta_blog}
              <IconArrow size={14} />
            </a>
            <a href="/about" class="hp-btn hp-btn--blue">{hp.hero.cta_about}</a>
          </div>
        </div>

        <!-- Right column: "Most read" side-card + latest pill + stats -->
        <div class="hp-hero__right">
          {heroPost && (
            <div class="hp-hero__card-wrap">
              <PostCard
                post={heroPost}
                variant="medium"
                badge={hp.hero.badge_most_read}
                readTime={getReadTime(heroPost)}
                loading="eager"
              />
            </div>
          )}

          <!-- Latest post pill -->
          {latestPost && (
            <a
              href={`/${blog_folder}/${latestPost.data.slug || latestPost.id}`}
              class="hp-hero__new-pill"
            >
              <span class="hp-hero__new-dot"></span>
              {hp.hero.new_post_prefix} {latestPost.data.title}
            </a>
          )}

          <!-- Stats row -->
          <div class="hp-stats">
            <div class="hp-stats__item">
              <span class="hp-stats__num">{postCount}</span>
              <span class="hp-stats__label">{hp.hero.stats_posts_label}</span>
            </div>
            <div class="hp-stats__item">
              <span class="hp-stats__num">{yearsWriting}</span>
              <span class="hp-stats__label">{hp.hero.stats_years_label}</span>
            </div>
          </div>
        </div>
      </div>
      </div>
    </section>

    <!-- ════════════════════ ACTIVITY RIBBON ══════════════════ -->
    <div class="hp-ribbon">
      <div class="hp-wrap hp-ribbon__flex">
      <div class="hp-ribbon__left">
        <span class="hp-ribbon__gear" aria-hidden="true">⚙</span>
        <span class="hp-ribbon__slogan">
          {hp.ribbon.slogan}
          <em class="hp-ribbon__slogan-em">{hp.ribbon.slogan_em}</em>
        </span>
      </div>
      <div class="hp-ribbon__right">
        <span class="hp-ribbon__dot" aria-hidden="true"></span>
        <span>
          Latest: <strong>{daysAgo} days ago</strong>
          {latestPost?.data?.category && <> · <strong>{latestPost.data.category}</strong></>}
        </span>
      </div>
      </div>
    </div>

    <!-- ══════════════════ LATEST WRITING ═════════════════════ -->
    <section class="hp-posts" id="main">
      <div class="hp-wrap">
      <div class="hp-posts__head">
        <div>
          <h2 class="hp-posts__h2">
            {hp.latest.heading.split(' ').slice(0, -1).join(' ')} <span class="hp-blue">{hp.latest.heading.split(' ').at(-1)}</span>
          </h2>
          <p class="hp-posts__sub">{hp.latest.sub}</p>
        </div>
        <a href={`/${blog_folder}`} class="hp-btn hp-btn--blue">
          {hp.latest.cta.replace('{posts}', String(postCount))}
          <IconArrow size={14} />
        </a>
      </div>

      <!-- Big featured card -->
      {featuredPost && (
        <div class="hp-posts__featured">
          <PostCard
            post={featuredPost}
            variant="big"
            badge={hp.latest.badge}
            readTime={getReadTime(featuredPost)}
            loading="eager"
          />
        </div>
      )}

      <!-- 3×2 grid -->
      <div class="hp-posts__grid">
        {gridPosts.map((post) => (
          <PostCard
            post={post}
            variant="small"
            readTime={getReadTime(post)}
          />
        ))}
      </div>
      </div>
    </section>

    <!-- ════════════════════ FOOTER ═══════════════════════════ -->
    <SiteFooter />
  </div>
</BaseRedesign>

<style>
  /* ================================================================== *
   * Homepage — scoped styles
   * ================================================================== */

  /* Page wrapper — sets the background and default font */
  .hp {
    background: var(--color-grey-50);
    color: var(--color-navy-900);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* ---- Shared utilities ---- */
  .hp-blue       { color: var(--color-blue-500); }
  .hp-yellow     { color: var(--color-yellow-400); }

  /* Centered content wrapper — used by every section */
  .hp-wrap {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 var(--container-px);
  }

  .hp-yellow-chip {
    background: var(--color-yellow-400);
    color: var(--color-navy-900);
    padding: 0 16px;
    display: inline-block;
    transform: skewX(-6deg);
  }

  /* Primary / outline buttons */
  .hp-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    padding: 16px 24px;
    border-radius: var(--radius-button);
    text-decoration: none;
    transition: opacity 0.15s ease;
    white-space: nowrap;
    border: none;
    cursor: pointer;
  }

  .hp-btn:hover { opacity: 0.88; }

  .hp-btn--blue {
    background: var(--color-blue-500);
    color: var(--color-on-accent);
    box-shadow: var(--shadow-cta);
  }

  .hp-btn--outline {
    background: transparent;
    color: var(--color-navy-900);
    border: 1.5px solid var(--color-navy-900);
    padding: 14px 22px;
  }

  /* ================================================================== *
   * Hero
   * ================================================================== */

  .hp-hero {
    position: relative;
    padding: 40px 0 64px;
    overflow: hidden;
  }

  .hp-hero__watermark {
    position: absolute;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 320px;
    color: rgba(58, 118, 255, 0.05);
    letter-spacing: -0.06em;
    bottom: -60px;
    left: -40px;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .hp-hero__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 48px;
    align-items: stretch;
    position: relative;
    z-index: 2;
  }

  /* Left column */
  .hp-hero__left {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hp-hero__new-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-navy-900);
    text-decoration: none;
    width: fit-content;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: border-color 0.15s;
    align-self: center;
  }

  .hp-hero__new-pill:hover {
    border-color: var(--color-blue-500);
  }

  .hp-hero__new-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
  }

  .hp-hero__h1 {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, var(--text-hero));
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--color-navy-900);
    text-wrap: balance;
  }

  .hp-hero__lede {
    margin-top: 40px;
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-ink-800);
    max-width: 620px;
  }

  .hp-hero__ctas {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  /* Right column */
  .hp-hero__right {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
  }

  .hp-hero__card-wrap {
    flex: 1;
    min-height: 340px;
  }

  /* Stats row */
  .hp-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--color-grey-100);
    font-family: var(--font-ui);
  }

  .hp-stats__item {
    text-align: center;
  }

  .hp-stats__num {
    display: block;
    font-size: 28px;
    font-weight: 700;
    color: var(--color-blue-500);
    line-height: 1;
  }

  .hp-stats__label {
    display: block;
    font-size: 11px;
    color: var(--color-grey-500);
    margin-top: 6px;
    letter-spacing: 0.02em;
  }

  /* ================================================================== *
   * Activity ribbon
   * ================================================================== */

  .hp-ribbon {
    background: var(--color-blue-500);
    color: var(--color-on-accent);
    overflow: hidden;
  }

  .hp-ribbon__flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding-top: 28px;
    padding-bottom: 28px;
  }

  .hp-ribbon__left {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-ui);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .hp-ribbon__gear {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--color-yellow-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-navy-900);
    font-weight: 800;
    font-size: 16px;
    flex-shrink: 0;
  }

  .hp-ribbon__slogan-em {
    font-style: italic;
    color: var(--color-yellow-400);
    margin-left: 4px;
  }

  .hp-ribbon__right {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    flex-shrink: 0;
    opacity: 0.95;
  }

  .hp-ribbon__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-yellow-400);
    box-shadow: 0 0 0 4px rgba(255, 195, 58, 0.25);
    flex-shrink: 0;
    animation: pulse 2s ease infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(255, 195, 58, 0.25); }
    50%       { box-shadow: 0 0 0 8px rgba(255, 195, 58, 0.1); }
  }

  .hp-ribbon__sep {
    width: 1px;
    height: 16px;
    background: rgba(255, 255, 255, 0.3);
  }

  /* ================================================================== *
   * Latest writing section
   * ================================================================== */

  .hp-posts {
    padding: var(--section-py) 0;
    background: var(--color-grey-50);
  }

  .hp-posts__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .hp-posts__h2 {
    font-family: var(--font-ui);
    font-size: var(--text-section-h2);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 0;
    color: var(--color-navy-900);
  }

  .hp-posts__sub {
    font-size: 14px;
    color: var(--color-grey-500);
    margin-top: 12px;
    margin-bottom: 0;
  }

  .hp-posts__featured {
    margin-bottom: 24px;
  }

  .hp-posts__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    row-gap: 32px;
  }

  /* ================================================================== *
   * Newsletter
   * ================================================================== */

  .hp-nl {
    padding: var(--section-py) 0;
    background: var(--color-navy-900);
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .hp-nl__bg {
    position: absolute;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 360px;
    color: rgba(58, 118, 255, 0.08);
    letter-spacing: -0.05em;
    right: -40px;
    top: -80px;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .hp-nl__wrap {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hp-nl__h2 {
    font-family: var(--font-ui);
    font-size: 72px;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }

  .hp-nl__body {
    font-size: 18px;
    color: var(--color-grey-400);
    margin-top: 24px;
    line-height: 1.5;
    max-width: 520px;
    margin-bottom: 0;
  }

  .hp-nl__form {
    background: #fff;
    border-radius: 14px;
    padding: 6px;
    display: flex;
    align-items: center;
    box-shadow: var(--shadow-nl-form);
  }

  .hp-nl__input {
    flex: 1;
    border: none;
    outline: none;
    padding: 18px;
    font-size: 16px;
    font-family: var(--font-body);
    color: var(--color-navy-900);
    background: transparent;
    min-width: 0;
  }

  .hp-nl__form .hp-btn {
    padding: 14px 20px;
    font-size: 14px;
    flex-shrink: 0;
  }

  .hp-nl__footnote {
    font-size: 13px;
    color: var(--color-grey-500);
    margin-top: 18px;
    font-family: var(--font-body);
  }

  /* ================================================================== *
   * Responsive — mobile collapse
   * ================================================================== */

  @media (max-width: 1023px) {
    .hp {
      --container-px: 32px;
    }
  }

  @media (max-width: 767px) {
    .hp {
      --container-px: 20px;
    }

    .hp-hero__grid {
      grid-template-columns: 1fr;
    }

    .hp-hero__h1 {
      font-size: clamp(3rem, 12vw, var(--text-hero));
    }

    .hp-hero__watermark {
      display: none;
    }

    .hp-ribbon__flex {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .hp-ribbon__left {
      font-size: 18px;
    }

    .hp-nl__wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hp-nl__h2 {
      font-size: clamp(2.5rem, 10vw, 72px);
    }

    .hp-posts__grid {
      grid-template-columns: 1fr;
    }

  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hp-posts__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ================================================================== *
   * Dark mode — residual overrides
   *
   * hp-btn--blue, hp-ribbon, hp-hero__new-pill no longer need overrides —
   * they now use on-accent / surface-card / border-card tokens that
   * auto-remap via tokens.css .dark block.
   *
   * Only purely decorative one-offs remain below.
   * ================================================================== */

  /* Slogan italic em: yellow-400 token → blue in dark on yellow ribbon.
     A muted dark tone reads better than the full blue reversal. */
  :global(.dark) .hp-ribbon__slogan-em {
    color: rgba(0, 0, 0, 0.55);
  }

  /* Pulse dot: on yellow ribbon the token-blue dot looks odd; use a dark dot */
  :global(.dark) .hp-ribbon__dot {
    background: rgba(0, 0, 0, 0.45);
    box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.12);
    animation: none;
  }
</style>
