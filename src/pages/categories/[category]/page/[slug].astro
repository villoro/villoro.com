---
import BlogListingLayout from "@/layouts/BlogListingLayout.astro";
import { getPublishedPosts } from "@/lib/posts";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { getTaxonomy } from "@/lib/taxonomy";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { getCategoryRibbonData, getYearsWriting } from "@/lib/listingData";
import { categoryMetadata } from "@/lib/categoryMetadata";
import { slugify } from "@/lib/utils/textConverter";
import config from "@/config/config.json";
import { getBlogListingCopy } from "@/lib/listingCopy";

const { pagination } = config.settings;

export async function getStaticPaths() {
  const { pagination } = (await import("@/config/config.json")).settings;
  const categories = await getTaxonomy("category");
  const paths = [];
  const items = await getPublishedPosts();
  for (const category of categories) {
    const filtered = taxonomyFilter(items, "category", category);
    const totalPages = Math.ceil(filtered.length / pagination);
    // Page 1 is the bare listing URL: start at 2, or /page/1/ would duplicate it
    for (let i = 2; i <= totalPages; i++) {
      paths.push({ params: { category, slug: i.toString() } });
    }
  }
  return paths;
}

const { category, slug } = Astro.params;
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;

const allPosts = await getPublishedPosts();
const sorted   = sortByDate(allPosts);

const filtered     = taxonomyFilter(allPosts, "category", category!);
const sortedPosts  = sortByDate(filtered);
const totalPages   = Math.ceil(sortedPosts.length / pagination);
const start        = (currentPage - 1) * pagination;
const currentPosts = sortedPosts.slice(start, start + pagination);

const metaEntry    = Object.entries(categoryMetadata).find(([key]) => slugify(key) === category);
// Routes come from the categories of published posts, which are categoryMetadata keys
const categoryName = metaEntry![1].name;

const { postCount, categories } = getCategoryRibbonData(sorted);
const yearsWriting = getYearsWriting();

const bi = await getBlogListingCopy();
---

<BlogListingLayout
  title={`${categoryName} — Page ${currentPage} — Villoro`}
  description={`All posts in the ${categoryName} category.`}
  breadcrumbs={[
    { href: "/",                        label: "Villoro" },
    { href: "/blog/",                    label: "Blog" },
    { href: `/categories/${category}/`,  label: categoryName },
    { label: `Page ${currentPage}` },
  ]}
  postCount={postCount}
  yearsWriting={yearsWriting}
  heroH1={bi.hero.h1}
  heroLede={bi.hero.lede}
  heroCountLabel={bi.hero.count_label}
  categories={categories}
  activeCategory={category}
  sectionTitle={categoryName}
  sectionMeta={`Page ${currentPage} of ${totalPages} · newest first`}
  currentPosts={currentPosts}
  currentPage={currentPage}
  totalPages={totalPages}
  paginationSection={`categories/${category}`}
/>
