---
import BlogListingLayout from "@/layouts/BlogListingLayout.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { getCategoryRibbonData, getYearsWriting } from "@/lib/listingData";
import { categoryMetadata } from "@/lib/categoryMetadata";
import { slugify, humanize } from "@/lib/utils/textConverter";
import config from "@/config/config.json";

const { blog_folder, pagination } = config.settings;

export async function getStaticPaths() {
  const { blog_folder, pagination } = (await import("@/config/config.json")).settings;
  const categories = await getTaxonomy(blog_folder, "category");
  const paths = [];
  for (const category of categories) {
    const items = await getSinglePage(blog_folder);
    const filtered = taxonomyFilter(items, "category", category);
    const totalPages = Math.ceil(filtered.length / pagination);
    for (let i = 1; i <= totalPages; i++) {
      paths.push({ params: { category } });
    }
  }
  return [...new Map(paths.map((p) => [p.params.category, p])).values()];
}

const { category } = Astro.params;
const allPosts = await getSinglePage(blog_folder);
const sorted   = sortByDate(allPosts);

const filtered     = taxonomyFilter(allPosts, "category", category!);
const sortedPosts  = sortByDate(filtered);
const totalPages   = Math.ceil(sortedPosts.length / pagination);
const currentPosts = sortedPosts.slice(0, pagination);

const metaEntry    = Object.entries(categoryMetadata).find(([key]) => slugify(key) === category);
const categoryName = metaEntry?.[1].name ?? humanize(category!);

const { postCount, categories } = getCategoryRibbonData(sorted);
const yearsWriting = getYearsWriting();
---

<BlogListingLayout
  title={`${categoryName} — Villoro`}
  description={`All posts in the ${categoryName} category.`}
  breadcrumbs={[
    { href: "/",     label: "Villoro" },
    { href: "/blog", label: "Blog" },
    { label: categoryName },
  ]}
  postCount={postCount}
  yearsWriting={yearsWriting}
  categories={categories}
  activeCategory={category}
  sectionTitle={categoryName}
  sectionMeta={`${sortedPosts.length} posts · newest first`}
  currentPosts={currentPosts}
  currentPage={1}
  totalPages={totalPages}
  paginationSection={`categories/${category}`}
/>
