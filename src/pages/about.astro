---
import BaseRedesign from "@/layouts/BaseRedesign.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import IconArrow from "@/components/IconArrow.astro";
import { Image } from "astro:assets";
import meImage from "../images/me.png";
import { getSinglePage } from "@/lib/contentParser.astro";
import config from "@/config/config.json";
import social from "@/config/social.json";
import { getCollection } from "astro:content";

// ---- Content ----
const [aboutEntry] = await getCollection("about");
const ab = aboutEntry.data;

const { blog_folder } = config.settings;
const posts      = await getSinglePage(blog_folder);
const postCount  = posts.length;

const writingSince = new Date(config.settings.writing_since);
const yearsWriting = Math.floor(
  (new Date().getTime() - writingSince.getTime()) / (365.25 * 24 * 60 * 60 * 1000)
);

const findSocial = (name: string) => social.main.find((s) => s.name === name)?.link ?? "#";

const timeline = ab.timeline?.entries ?? [];
---

<BaseRedesign
  title={ab.meta_title ?? ab.title ?? "About — Villoro"}
  description={ab.description}
>
  <div class="ab">

    <!-- ══════════════════════ NAV ════════════════════════ -->
    <SiteNav />

    <!-- ══════════════════════ HERO ═══════════════════════ -->
    <section class="ab-hero">
      <span class="ab-hero__bg" aria-hidden="true">{ab.hero.watermark}</span>
      <div class="ab-wrap">

        <nav class="ab-crumb" aria-label="breadcrumb">
          <a href="/" class="ab-crumb__link">Villoro</a>
          <IconArrow size={10} />
          <span class="ab-crumb__current">About</span>
        </nav>

        <div class="ab-hero__grid">
          <div class="ab-hero__left">
            <h1 class="ab-hero__h1">
              {ab.hero.h1[0]}<br />
              <span class="ab-blue">{ab.hero.h1[1]}</span>
            </h1>
            <p class="ab-hero__lede">{ab.hero.lede}</p>

            <div class="ab-hero__social">
              <a href={findSocial("linkedin")} target="_blank" rel="noopener noreferrer" class="ab-social-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>
                LinkedIn
              </a>
              <a href={findSocial("github")} target="_blank" rel="noopener noreferrer" class="ab-social-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.3 11.3 0 016 0C17.7 4.7 18.7 5 18.7 5c.7 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0023.5 12C23.5 5.7 18.3.5 12 .5z"/></svg>
                GitHub
              </a>
              <a href={findSocial("twitter")} target="_blank" rel="noopener noreferrer" class="ab-social-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                Twitter
              </a>
            </div>
          </div>

          <div class="ab-portrait-wrap">
            <div class="ab-portrait-badge">{ab.hero.badge}</div>
            <div class="ab-portrait">
              <Image
                src={meImage}
                alt="Arnau Villoro"
                widths={[240, 480, 720, meImage.width]}
                sizes="(max-width: 767px) 240px, (max-width: 1023px) 360px, 480px"
                loading="eager"
                class="ab-portrait__img"
              />
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════════════════ STORY ══════════════════════ -->
    <section class="ab-story-sec">
      <div class="ab-wrap ab-story-grid">
        <aside class="ab-story-label">
          <div class="ab-story-label__kicker">{ab.story.kicker}</div>
          <div class="ab-story-label__title">{ab.story.label}</div>
        </aside>
        <div class="ab-story-body">
          {ab.story.paragraphs.map((para) => (
            <p set:html={para.replace('{years}', String(yearsWriting)).replace('{posts}', String(postCount))} />
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════ TIMELINE ═════════════════════ -->
    <section class="ab-tl-sec">
      <div class="ab-wrap">
        <div class="ab-tl-head">
          <div>
            <div class="ab-tl-kicker">{ab.timeline.kicker}</div>
            <h2 class="ab-tl-h">{yearsWriting} {ab.timeline.heading_suffix}</h2>
          </div>
          <p class="ab-tl-sub">{ab.timeline.sub}</p>
        </div>
        <div class="ab-tl-grid">
          {timeline.map((t) => (
            <article class="ab-tl-card">
              <div class="ab-tl-year">{t.year}</div>
              <div class="ab-tl-role">{t.role}</div>
              <div class="ab-tl-co">{t.co}</div>
              <p class="ab-tl-desc">{t.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════ BEYOND THE TERMINAL ══════════════ -->
    <section class="ab-beyond-sec">
      <div class="ab-wrap">
        <div class="ab-beyond-head">
          <div class="ab-beyond-kicker">{ab.hobbies.kicker}</div>
          <h2 class="ab-beyond-h">
            {ab.hobbies.heading.split(' ').slice(0, -1).join(' ')} <span class="ab-blue">{ab.hobbies.heading.split(' ').at(-1)}</span>
          </h2>
        </div>
        <div class="ab-beyond-grid">
          {ab.hobbies.entries.map((hobby) => (
            <article class="ab-beyond-card">
              <div class="ab-beyond-emoji">{hobby.emoji}</div>
              <h3 class="ab-beyond-title">{hobby.title}</h3>
              <p class="ab-beyond-text">{hobby.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════ FOOTER ═════════════════════ -->
    <SiteFooter />

  </div>
</BaseRedesign>

<style is:global>
  /* Timeline section — permanent dark surface */
  .ab-tl-sec {
    background: var(--color-surface-dark) !important;
    color: var(--color-on-dark) !important;
  }

  /* Hobby cards — switches between white (light) and #2b2b2b (dark) */
  .ab-beyond-card {
    background: var(--color-surface-card) !important;
    border-color: var(--color-border-card) !important;
  }
</style>

<style>
  .ab {
    background: var(--color-grey-50);
    color: var(--color-navy-900);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
    --container-px: 64px;
  }

  .ab-wrap {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 var(--container-px);
  }

  .ab-blue { color: var(--color-blue-500); }

  .ab-hi {
    background: linear-gradient(transparent 62%, rgba(255, 195, 58, 0.45) 62%);
    padding: 0 2px;
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */

  .ab-hero {
    position: relative;
    padding: 40px 0 64px;
    overflow: hidden;
  }

  .ab-hero__bg {
    position: absolute;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 320px;
    color: rgba(58, 118, 255, 0.05);
    letter-spacing: -0.06em;
    bottom: -80px;
    left: -40px;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .ab-crumb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-grey-500);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .ab-crumb__link {
    color: var(--color-grey-500);
    text-decoration: none;
    transition: color 0.15s;
  }
  .ab-crumb__link:hover { color: var(--color-blue-500); }
  .ab-crumb__current    { color: var(--color-blue-500); }

  .ab-hero__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 64px;
    align-items: start;
    position: relative;
    z-index: 2;
  }

  .ab-hero__h1 {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(3.5rem, 8vw, 116px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--color-navy-900);
    text-wrap: balance;
  }

  .ab-hero__lede {
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-navy-900);
    opacity: 0.8;
    margin: 28px 0 0;
    max-width: 640px;
  }

  .ab-hero__social {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 28px;
    font-family: var(--font-ui);
  }

  .ab-social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-navy-900);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: color 0.15s;
  }
  .ab-social-link:hover { color: var(--color-blue-500); }

  /* Portrait */
  .ab-portrait-wrap {
    position: relative;
    margin-top: 20px;
  }

  .ab-portrait-badge {
    position: absolute;
    top: -14px;
    left: -14px;
    background: var(--color-yellow-400);
    color: var(--color-navy-900);
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 13px;
    padding: 10px 14px;
    border-radius: 999px;
    box-shadow: 0 8px 24px -8px rgba(255, 195, 58, 0.6);
    transform: rotate(-4deg);
    z-index: 3;
    white-space: nowrap;
  }

  .ab-portrait {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgba(255, 195, 58, 0.55);
    display: block;
  }

  .ab-portrait__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }


  /* ── Story ────────────────────────────────────────────────────────── */

  .ab-story-sec {
    padding: 40px 0 80px;
  }

  .ab-story-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 80px;
    align-items: start;
  }

  .ab-story-label {
    position: sticky;
    top: 100px;
    font-family: var(--font-ui);
  }

  .ab-story-label__kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-blue-500);
    margin-bottom: 10px;
  }

  .ab-story-label__title {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-navy-900);
  }

  .ab-story-body {
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-navy-900);
    opacity: 0.85;
    max-width: 720px;
  }
  .ab-story-body p { margin: 0 0 22px; }
  .ab-story-body p:last-child { margin-bottom: 0; }
  .ab-story-body strong { color: var(--color-navy-900); font-weight: 700; opacity: 1; }

  /* ── Timeline ─────────────────────────────────────────────────────── */

  .ab-tl-sec {
    background: var(--color-surface-dark);
    color: var(--color-on-dark);
    padding: 72px 0 80px;
  }

  .ab-tl-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 48px;
    font-family: var(--font-ui);
    flex-wrap: wrap;
  }

  .ab-tl-kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-yellow-400);
    margin-bottom: 8px;
  }

  .ab-tl-h {
    font-size: clamp(2rem, 4.5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
    color: var(--color-on-dark);
  }

  .ab-tl-sub {
    font-size: 14px;
    color: var(--color-on-dark-secondary);
    max-width: 320px;
    text-align: right;
    margin: 0;
    line-height: 1.55;
  }

  .ab-tl-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
  }

  .ab-tl-card {
    background: rgba(255, 255, 255, 0.04);
    padding: 28px 24px 32px;
    border-top: 2px solid var(--color-blue-500);
    font-family: var(--font-ui);
  }

  .ab-tl-year {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-yellow-400);
    margin-bottom: 10px;
  }
  .ab-tl-role {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
    color: var(--color-on-dark);
  }
  .ab-tl-co {
    font-size: 14px;
    color: var(--color-on-dark-faint);
    margin-bottom: 14px;
  }
  .ab-tl-desc {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-on-dark-secondary);
    margin: 0;
  }

  /* ── Beyond the terminal ──────────────────────────────────────────── */

  .ab-beyond-sec {
    padding: 72px 0 40px;
  }

  .ab-beyond-head {
    margin-bottom: 48px;
    font-family: var(--font-ui);
  }

  .ab-beyond-kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-blue-500);
    margin-bottom: 10px;
  }

  .ab-beyond-h {
    font-size: clamp(2.25rem, 4.5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
    color: var(--color-navy-900);
  }

  .ab-beyond-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .ab-beyond-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border-card);
    border-radius: 20px;
    padding: 36px 28px;
    font-family: var(--font-ui);
    transition: border-color 0.2s, transform 0.2s;
  }
  .ab-beyond-card:hover {
    border-color: var(--color-blue-500);
    transform: translateY(-2px);
  }

  .ab-beyond-emoji { font-size: 36px; margin-bottom: 18px; line-height: 1; }

  .ab-beyond-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 10px;
    color: var(--color-navy-900);
  }

  .ab-beyond-text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-navy-900);
    opacity: 0.75;
    margin: 0;
    font-family: var(--font-body);
  }

  /* ── CTA ──────────────────────────────────────────────────────────── */

  .ab-cta-sec {
    padding: 40px 0 80px;
  }

  .ab-cta-card {
    background: var(--color-blue-500);
    border-radius: 24px;
    padding: 56px 56px 60px;
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    font-family: var(--font-ui);
    position: relative;
    overflow: hidden;
  }

  .ab-cta-bg {
    position: absolute;
    font-weight: 700;
    font-size: 260px;
    color: rgba(255, 255, 255, 0.08);
    letter-spacing: -0.06em;
    bottom: -60px;
    right: -20px;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .ab-cta-h {
    font-size: clamp(2rem, 3.6vw, 48px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0;
    max-width: 560px;
    text-wrap: balance;
    position: relative;
    z-index: 1;
  }

  .ab-cta-btns {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  .ab-cta-primary {
    background: var(--color-yellow-400);
    color: var(--color-navy-900);
    padding: 16px 24px;
    border: none;
    border-radius: 12px;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .ab-cta-primary:hover { opacity: 0.9; }

  .ab-cta-secondary {
    background: transparent;
    color: #fff;
    padding: 16px 24px;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 12px;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .ab-cta-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.7);
  }

  /* ── Dark mode ───────────────────────────────────────────────────── */
  /* ab-tl-sec and ab-beyond-card no longer need :global(.dark) overrides —
     they now use surface-dark / surface-card / border-card tokens that
     auto-remap in the .dark block in tokens.css. */

  /* Portrait badge: background is yellow-400 (→ blue in dark), so we need
     white text in dark mode. :global(.dark) is required because Astro's CSS
     scoping would add the component hash to .dark, and <html> never has it. */
  :global(.dark) .ab-portrait-badge {
    color: var(--color-on-dark);
  }

  /* ── Responsive ───────────────────────────────────────────────────── */

  @media (max-width: 1023px) {
    .ab { --container-px: 32px; }
    .ab-hero__grid { grid-template-columns: 1fr; gap: 48px; }
    .ab-story-grid { grid-template-columns: 1fr; gap: 24px; }
    .ab-story-label { position: static; }
    .ab-tl-grid { grid-template-columns: repeat(2, 1fr); }
    .ab-beyond-grid { grid-template-columns: repeat(2, 1fr); }
    .ab-tl-sub { text-align: left; }
    .ab-cta-card { flex-direction: column; align-items: flex-start; padding: 40px; }
  }

  @media (max-width: 767px) {
    .ab { --container-px: 20px; }
    .ab-hero__bg { display: none; }
    .ab-tl-grid { grid-template-columns: 1fr; }
    .ab-beyond-grid { grid-template-columns: 1fr; }
    .ab-portrait-badge { font-size: 11px; padding: 8px 12px; top: -10px; left: -10px; }
    .ab-cta-card { padding: 32px 24px; }
    .ab-cta-bg { font-size: 160px; bottom: -30px; }
  }
</style>
