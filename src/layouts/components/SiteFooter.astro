---
import config from "@/config/config.json";
import social from "@/config/social.json";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      Made by&nbsp;
      <a href={`mailto:${config.footer.email}`} class="site-footer__email">
        {config.footer.email}
      </a>
      &nbsp;· Barcelona · © 2014
    </div>
    <div class="site-footer__social">
      {social.main.map((s) => (
        <a
          href={s.link}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.name}
          class="site-footer__social-link"
        >
          {s.name === "github" && (
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.3 11.3 0 016 0C17.7 4.7 18.7 5 18.7 5c.7 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0023.5 12C23.5 5.7 18.3.5 12 .5z"/>
            </svg>
          )}
          {s.name === "linkedin" && (
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"/>
            </svg>
          )}
          {s.name === "twitter" && (
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          )}
        </a>
      ))}
    </div>
  </div>
</footer>

<style is:global>
  .site-footer {
    padding: 40px 0;
    background: var(--color-surface-dark);  /* always dark navy — token never remaps */
    color: var(--color-grey-400);
    font-size: 13px;
    font-family: var(--font-ui);
  }

  .site-footer__inner {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 var(--container-px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .site-footer__email {
    color: var(--color-blue-500);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .site-footer__email:hover { opacity: 0.8; }

  .site-footer__social {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .site-footer__social-link {
    color: var(--color-grey-400);
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .site-footer__social-link:hover { color: var(--color-grey-300); }

  @media (max-width: 767px) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
