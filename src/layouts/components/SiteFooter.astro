---
import config from "@/config/config.json";
import social from "@/config/social.json";
import SocialIcon from "@/components/SocialIcon.astro";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      Made by&nbsp;
      <a href={`mailto:${config.footer.email}`} class="site-footer__email">
        {config.footer.email}
      </a>
      &nbsp;· Barcelona · © 2014
    </div>
    <div class="site-footer__social">
      {social.main.map((s) => (
        <a
          href={s.link}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.name}
          class="site-footer__social-link"
        >
          <SocialIcon name={s.name as any} />
        </a>
      ))}
    </div>
  </div>
</footer>

<style is:global>
  .site-footer {
    padding: 40px 0;
    background: var(--color-surface-dark);  /* always dark navy — token never remaps */
    color: var(--color-grey-400);
    font-size: 13px;
    font-family: var(--font-ui);
  }

  .site-footer__inner {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 var(--container-px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .site-footer__email {
    color: var(--color-blue-500);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .site-footer__email:hover { opacity: 0.8; }

  .site-footer__social {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .site-footer__social-link {
    color: var(--color-grey-400);
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .site-footer__social-link:hover { color: var(--color-grey-300); }

  @media (max-width: 767px) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
