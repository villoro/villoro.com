---
import config from "@/config/config.json";
const { page_name, pagination_window_size } = config.settings;

type Pagination = {
  section?: string;
  currentPage?: number;
  totalPages?: number;
};
const { section, currentPage = 1, totalPages = 1 }: Pagination = Astro.props;

const WINDOW_SIZE = pagination_window_size;

const indexPageLink = currentPage === 2;
const hasPrevPage = currentPage > 1;
const hasNextPage = totalPages > currentPage;

function pageUrl(page: number) {
  if (page === 1) return section ? `/${section}` : "/";
  return `${section ? "/" + section : ""}/${page_name}/${page}`;
}

// Build the list of page entries to render: numbers or "ellipsis" markers
type PageEntry = number | "ellipsis-start" | "ellipsis-end";

function buildPageList(): PageEntry[] {
  if (totalPages <= 1) return [];

  let windowStart = Math.max(2, currentPage - WINDOW_SIZE);
  let windowEnd = Math.min(totalPages - 1, currentPage + WINDOW_SIZE);

  // If truncated at start, expand toward end to keep window full
  if (currentPage - WINDOW_SIZE < 2)
    windowEnd = Math.min(totalPages - 1, windowEnd + (2 - (currentPage - WINDOW_SIZE)));
  // If truncated at end, expand toward start to keep window full
  if (currentPage + WINDOW_SIZE > totalPages - 1)
    windowStart = Math.max(2, windowStart - ((currentPage + WINDOW_SIZE) - (totalPages - 1)));

  const pages: PageEntry[] = [1];

  if (windowStart > 2) pages.push("ellipsis-start");
  for (let i = windowStart; i <= windowEnd; i++) pages.push(i);
  if (windowEnd < totalPages - 1) pages.push("ellipsis-end");

  if (totalPages > 1) pages.push(totalPages);

  return pages;
}

const pageList = buildPageList();
---

{totalPages > 1 && (
  <nav class="pg-nav flex items-center justify-center space-x-3" aria-label="Pagination">
    {/* previous */}
    {hasPrevPage ? (
      <a
        href={indexPageLink ? pageUrl(1) : pageUrl(currentPage - 1)}
        class="rounded px-2 py-1.5 text-dark hover:bg-theme-light dark:text-darkmode-dark dark:hover:bg-darkmode-theme-light"
      >
        <span class="sr-only">Previous</span>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" height="30" width="30">
          <path
            fill-rule="evenodd"
            d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
            clip-rule="evenodd"
          />
        </svg>
      </a>
    ) : (
      <span class="rounded px-2 py-1.5 text-light">
        <span class="sr-only">Previous</span>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" height="30" width="30">
          <path
            fill-rule="evenodd"
            d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
            clip-rule="evenodd"
          />
        </svg>
      </span>
    )}

    {/* page index */}
    {pageList.map((entry) =>
      entry === "ellipsis-start" || entry === "ellipsis-end" ? (
        <span class="px-2 py-2 text-dark dark:text-darkmode-dark select-none">…</span>
      ) : entry === currentPage ? (
        <span
          aria-current="page"
          class="rounded bg-primary px-4 py-2 text-white dark:bg-darkmode-primary dark:text-dark"
        >
          {entry}
        </span>
      ) : (
        <a
          href={pageUrl(entry)}
          class="rounded px-4 py-2 text-dark hover:bg-theme-light dark:text-darkmode-dark dark:hover:bg-darkmode-theme-light"
        >
          {entry}
        </a>
      )
    )}

    {/* next page */}
    {hasNextPage ? (
      <a
        href={pageUrl(currentPage + 1)}
        class="rounded px-2 py-1.5 text-dark hover:bg-theme-light dark:text-darkmode-dark dark:hover:bg-darkmode-theme-light"
      >
        <span class="sr-only">Next</span>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" height="30" width="30">
          <path
            fill-rule="evenodd"
            d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
            clip-rule="evenodd"
          />
        </svg>
      </a>
    ) : (
      <span class="rounded px-2 py-1.5 text-light">
        <span class="sr-only">Next</span>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" height="30" width="30">
          <path
            fill-rule="evenodd"
            d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
            clip-rule="evenodd"
          />
        </svg>
      </span>
    )}
  </nav>
)}

<style>
  /* On mobile the desktop padding/gap easily overflow the viewport
     (current page chip clipped, arrows pushed off-screen).
     Tighten spacing and shrink arrow icons; allow wrap as a final
     safety net on very narrow screens when the window expands to
     ~10 entries (e.g. on page 1 of a long archive). */
  @media (max-width: 600px) {
    .pg-nav {
      flex-wrap: wrap;
      gap: 4px;
      row-gap: 6px;
    }
    /* Disable Tailwind's space-x-3 horizontal margin since gap handles it */
    .pg-nav > :not([hidden]) ~ :not([hidden]) { margin-left: 0; }

    .pg-nav a,
    .pg-nav span {
      padding-left: 8px;
      padding-right: 8px;
      padding-top: 4px;
      padding-bottom: 4px;
      font-size: 14px;
    }
    .pg-nav svg { height: 22px; width: 22px; }
  }
</style>
