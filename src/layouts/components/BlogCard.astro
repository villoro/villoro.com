---
import config from "@/config/config.json";
import BlogDetails from "@/components/BlogDetails.astro";
import ImageMod from "./ImageMod.astro";

const { blog_folder } = config.settings;
const { data, loading } = Astro.props;
const { title, image, date, category } = data.data;
---

<div class="bg-body dark:bg-darkmode-body">
  <a href={`/${blog_folder}/${data.data.slug || data.id}`}>
    {image && (
      <>
        <div class="mb-6 aspect-video overflow-hidden rounded">
          <ImageMod
            src={image}
            class={"w-full h-full object-cover"}
            width={480}
            height={270}
            alt={title}
            format="webp"
            loading={loading}
          />
        </div>
      </>
    )}
    <h4 class="mb-3 hover:text-primary dark:hover:text-darkmode-primary">{title}</h4>
  </a>

  <BlogDetails date={date} category={category} tags={null} />
</div>
