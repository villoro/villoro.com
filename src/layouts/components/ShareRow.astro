---
/**
 * ShareRow — copy-link + social share buttons below a blog post.
 * Handles the copy-to-clipboard interaction via a small inline script.
 */
import config from "@/config/config.json";
import SocialIcon from "@/components/SocialIcon.astro";

interface Props {
  title: string;
  slug: string; // e.g. "querying-apis-best-practices"
  blogFolder?: string; // default: config.settings.blog_folder
}

const { title, slug, blogFolder = config.settings.blog_folder } = Astro.props;

const base = config.site.base_url;
const postUrl = `${base}/${blogFolder}/${slug}/`;
---

<div class="sr">
  <span class="sr__label">Share this post</span>
  <div class="sr__btns">
    <!-- Copy link -->
    <button
      type="button"
      class="icon-btn icon-btn-blue"
      aria-label="Copy link"
      data-sr-copy
    >
      <span class="sr__copy-icon">
        <SocialIcon name="copy" size={16} />
      </span>
      <svg
        class="sr__done-icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </button>
    <!-- Announces the result; outside the button, whose children are presentational -->
    <span class="sr-only" role="status" data-sr-status></span>

    <!-- LinkedIn -->
    <a
      class="icon-btn icon-btn-blue"
      aria-label="Share on LinkedIn"
      href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(postUrl)}&title=${encodeURIComponent(title)}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <SocialIcon name="linkedin" />
    </a>

    <!-- Twitter / X -->
    <a
      class="icon-btn icon-btn-blue"
      aria-label="Share on Twitter"
      href={`https://twitter.com/intent/tweet/?text=${encodeURIComponent(title)}&url=${encodeURIComponent(postUrl)}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <SocialIcon name="twitter" size={16} />
    </a>

    <!-- Email -->
    <a
      class="icon-btn icon-btn-blue"
      aria-label="Share by email"
      href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(postUrl)}`}
    >
      <SocialIcon name="email" />
    </a>
  </div>
</div>

<script>
  function initCopyBtn() {
    document.querySelectorAll<HTMLElement>("[data-sr-copy]").forEach((btn) => {
      // astro:after-swap and astro:page-load both call this: bind once
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      const status = btn.nextElementSibling as HTMLElement | null;
      let timer: number;
      btn.addEventListener("click", async () => {
        let ok = true;
        try {
          await navigator.clipboard.writeText(window.location.href);
        } catch {
          ok = false;
        }
        clearTimeout(timer);
        // Icon swap, not a colour flash: the button is already blue
        btn.toggleAttribute("data-copied", ok);
        if (status) status.textContent = ok ? "Link copied" : "Copy failed";
        timer = window.setTimeout(() => {
          btn.removeAttribute("data-copied");
          if (status) status.textContent = "";
        }, 1500);
      });
    });
  }
  document.addEventListener("astro:page-load", initCopyBtn);
  document.addEventListener("astro:after-swap", initCopyBtn);
</script>

<style>
  .sr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    border-top: 1px solid var(--color-grey-100);
    border-bottom: 1px solid var(--color-grey-100);
    margin: 0 0 40px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .sr__label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-grey-500);
  }

  .sr__btns {
    display: flex;
    gap: 8px;
  }

  .sr__done-icon,
  [data-sr-copy][data-copied] .sr__copy-icon {
    display: none;
  }
  [data-sr-copy][data-copied] .sr__done-icon {
    display: block;
  }

  @media (max-width: 767px) {
    .sr {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
