---
/**
 * IconArrow — shared right-arrow icon used by CTAs, breadcrumbs, post cards.
 * Matches the Lucide / Feather "arrow-right" path.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 14, class: cls } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={cls}
>
  <path d="M5 12h14M13 5l7 7-7 7" />
</svg>
