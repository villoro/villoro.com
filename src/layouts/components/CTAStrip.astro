---
/**
 * CTAStrip — "Enjoyed this?" box with Buy-me-a-coffee + Subscribe buttons.
 * Used at the end of every blog post.
 */
import config from "@/config/config.json";
---

<div class="cta">
  <div class="cta__text">
    <div class="cta__kicker">Enjoyed this?</div>
    <div class="cta__question">Support the blog or get the next one in your inbox.</div>
  </div>
  <div class="cta__buttons">
    <script
      is:inline
      type="text/javascript"
      src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js"
      data-name="bmc-button"
      data-slug="villoro"
      data-color="#FFDD00"
      data-emoji=""
      data-font="Cookie"
      data-text="Buy me a coffee"
      data-outline-color="#000000"
      data-font-color="#000000"
      data-coffee-color="#ffffff"
    ></script>
    <a
      href={config.subscribe.link}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary cta__subscribe"
    >
      {config.subscribe.title}
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</div>

<style>
  .cta {
    margin: 56px 0 32px;
    padding: 28px 32px;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border-card);
    border-radius: 16px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cta__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cta__kicker {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-grey-500);
  }

  .cta__question {
    font-family: var(--font-ui);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-navy-900);
  }

  .cta__buttons {
    display: flex;
    gap: 10px;
    margin-left: auto;
    flex-wrap: wrap;
  }

  .cta__subscribe {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    font-family: var(--font-ui);
    font-size: 14px;
    box-shadow: var(--shadow-cta);
  }

  /* No dark mode override needed — surface-card and border-card tokens
     auto-remap (#2b2b2b bg / #3e3e3e border). navy-900 text and grey-500
     kicker both remap correctly via tokens.css. */

  @media (max-width: 767px) {
    .cta { flex-direction: column; align-items: flex-start; padding: 22px; }
    .cta__buttons { margin-left: 0; width: 100%; }
    .cta__subscribe { flex: 1; justify-content: center; }
  }
</style>
