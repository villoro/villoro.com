---
/**
 * CategoryRibbon — sticky blue category filter bar used on all listing pages.
 *
 * Props:
 *   categories   — array of { key, name, count }; "all" key links to /blog.
 *   activeKey    — slug of the currently active category, or "all".
 */
import { slugify } from "@/lib/utils/textConverter";
import type { CategoryItem } from "@/lib/listingData";

interface Props {
  categories: CategoryItem[];
  activeKey: string; // "all" or a slugified category key
}

const { categories, activeKey } = Astro.props;
---

<div class="cr">
  <div class="cr__inner">
    <span class="cr__label">Category</span>
    <div class="cr__chips" data-cr-chips>
      {categories.map((cat) => {
        const href =
          cat.key === "all" ? "/blog/" : `/categories/${slugify(cat.key)}/`;
        const isActive =
          cat.key === "all"
            ? activeKey === "all"
            : slugify(cat.key) === activeKey;
        return (
          <a
            href={href}
            class:list={["cr__chip", { "is-active": isActive }]}
            aria-current={isActive ? "page" : undefined}
          >
            {cat.name}
            <span class="cr__chip-count">{cat.count}</span>
          </a>
        );
      })}
    </div>
  </div>
</div>

<style>
  .cr {
    background: var(--color-blue-500);
    position: sticky;
    /* Just under the sticky nav, whatever its height is today (set by the
       script below; 87px is the desktop height at the default font size) */
    top: calc(var(--nav-h, 87px) - 1px);
    z-index: 20;
    box-shadow: 0 8px 24px -12px rgba(58, 118, 255, 0.4);
  }

  .cr__inner {
    max-width: 1312px;
    margin: 0 auto;
    padding: 12px var(--container-px);
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cr__label {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    flex-shrink: 0;
  }
  :global(.dark) .cr__label {
    color: rgba(0, 0, 0, 0.8);
  }

  /* One row that scrolls sideways instead of wrapping: wrapped, the 11 chips
     made the ribbon 157px tall, a third of a laptop screen while sticky. */
  .cr__chips {
    display: flex;
    gap: 8px;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.45) transparent;
    padding-bottom: 6px; /* room for the scrollbar */
    margin-bottom: -6px;
  }
  :global(.dark) .cr__chips {
    scrollbar-color: rgba(0, 0, 0, 0.4) transparent;
  }
  /* Fade the edge(s) with more chips off-screen (data-more, set below) */
  .cr__chips[data-more~="right"] {
    mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
  }
  .cr__chips[data-more~="left"] {
    mask-image: linear-gradient(to left, #000 calc(100% - 40px), transparent);
  }
  .cr__chips[data-more~="left"][data-more~="right"] {
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 40px,
      #000 calc(100% - 40px),
      transparent
    );
  }

  .cr__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .cr__chip:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .cr__chip.is-active {
    background: #fff;
    color: #1c1c1c;
  }

  :global(.dark) .cr {
    box-shadow: 0 8px 24px -12px rgba(255, 195, 58, 0.3);
  }
  :global(.dark) .cr__chip {
    background: rgba(0, 0, 0, 0.1);
    color: rgba(0, 0, 0, 0.8);
  }
  :global(.dark) .cr__chip:hover {
    background: rgba(0, 0, 0, 0.18);
  }
  :global(.dark) .cr__chip.is-active {
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
  }

  .cr__chip-count {
    font-size: 0.6875rem;
    font-weight: 700;
    opacity: 0.95;
  }
  .cr__chip.is-active .cr__chip-count {
    opacity: 0.7;
  }

  @media (max-width: 767px) {
    .cr {
      position: static;
    }
    /* The chips need the width; the label stays for screen readers */
    .cr__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>

<script>
  const setup = () => {
    // Sticky offset: the real height of the nav, which changes with the font size
    const nav = document.querySelector<HTMLElement>(".sitenav");
    if (nav)
      document.documentElement.style.setProperty(
        "--nav-h",
        `${nav.offsetHeight}px`,
      );

    document
      .querySelectorAll<HTMLElement>("[data-cr-chips]")
      .forEach((chips) => {
        const update = () => {
          const max = chips.scrollWidth - chips.clientWidth;
          const more: string[] = [];
          if (max > 8 && chips.scrollLeft > 1) more.push("left");
          if (max > 8 && chips.scrollLeft < max - 1) more.push("right");
          if (more.length) chips.dataset.more = more.join(" ");
          else delete chips.dataset.more;
        };
        if (!chips.dataset.bound) {
          chips.dataset.bound = "true";
          chips.addEventListener("scroll", update, { passive: true });
          window.addEventListener("resize", update);
        }
        // Show the current category: centre its chip (scrollLeft, not
        // scrollIntoView, so the page itself never scrolls)
        const active = chips.querySelector<HTMLElement>(".is-active");
        if (active) {
          const left =
            active.getBoundingClientRect().left -
            chips.getBoundingClientRect().left +
            chips.scrollLeft;
          chips.scrollLeft =
            left - (chips.clientWidth - active.offsetWidth) / 2;
        }
        update();
      });
  };
  window.addEventListener("resize", () => {
    const nav = document.querySelector<HTMLElement>(".sitenav");
    if (nav)
      document.documentElement.style.setProperty(
        "--nav-h",
        `${nav.offsetHeight}px`,
      );
  });
  document.addEventListener("astro:page-load", setup);
</script>
