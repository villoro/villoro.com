---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { resolveImage } from "@/lib/utils/blogImages";

// Props interface for the component
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
  widths?: number[];
  class?: string;
  style?: any;
}

// Destructuring Astro.props to get the component's props
const {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  fetchpriority,
  class: className,
  sizes,
  widths,
  style,
} = Astro.props;

// Resolves "/images/..." against src/images/blog first, then public/images
const loader = resolveImage(src);

if (!loader) {
  console.error(
    `\x1b[31mImage not found - ${src}.\x1b[0m Make sure the image is in src/images/blog or public/images.`,
  );
}
---

{loader && (
  <Picture
    src={loader() as Promise<{ default: ImageMetadata }>}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    sizes={sizes}
    widths={widths}
    class={className}
    formats={["avif", "webp"]}
    style={style}
  />
)}
