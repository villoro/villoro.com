---
/**
 * BaseRedesign — head-only layout wrapper for redesign 3.0 pages.
 * Same <head> as Base.astro but without the legacy Header/Footer.
 * Each page using this layout renders its own SiteNav and footer.
 */
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import { resolveImage } from "@/lib/utils/blogImages";
import { getImage } from "astro:assets";
import "@/styles/main.css";
import { AstroFont } from "astro-font";
import { ClientRouter } from "astro:transitions";
import { pwaInfo } from "virtual:pwa-info";
import SearchModal from "./helpers/SearchModal";

// Heebo + Signika are self-hosted in public/fonts (latin + latin-ext subsets of
// the variable fonts). Fetching them from Google at build time broke the build:
// Google sometimes returns extensionless /l/font?kit=... URLs that astro-font rejects.
const LATIN =
  "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD";
const LATIN_EXT =
  "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF";

// One variable file per subset serves every weight; preload only the latin file
const fontSources = (file: string, weights: number[], preload = false) =>
  weights.flatMap((weight, i) => [
    {
      path: `./public/fonts/${file}-latin.woff2`,
      weight,
      style: "normal",
      css: { "unicode-range": LATIN },
      preload: preload && i === 0,
    },
    {
      path: `./public/fonts/${file}-latin-ext.woff2`,
      weight,
      style: "normal",
      css: { "unicode-range": LATIN_EXT },
    },
  ]);

let fontPrimary, fontSecondary;
if (theme.fonts.font_family.primary) {
  fontPrimary = theme.fonts.font_family.primary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;]+/gi, "");
}
if (theme.fonts.font_family.secondary) {
  fontSecondary = theme.fonts.font_family.secondary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;]+/gi, "");
}

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  prevHref?: string;
  nextHref?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  prevHref,
  nextHref,
  ogType = "website",
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;

const resolvedCanonical = canonical ?? `${config.site.base_url}${Astro.url.pathname}`;

// OG/Twitter image must be an absolute URL to a real served file. Blog images
// live in src/images/blog (not served verbatim), so resolve through the image
// pipeline; public/ paths (e.g. a future meta_image) pass through unchanged.
const rawOgImage = image ?? (config.metadata as { meta_image?: string }).meta_image ?? "";
let ogImageUrl = rawOgImage ? `${config.site.base_url}${rawOgImage}` : "";
const ogLoader = rawOgImage ? resolveImage(rawOgImage) : undefined;
if (ogLoader) {
  const mod = await ogLoader();
  // jpg, not the webp default — LinkedIn/WhatsApp scrapers don't render webp
  const og = await getImage({ src: mod.default, width: 1200, format: "jpg" });
  ogImageUrl = `${config.site.base_url}${og.src}`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="shortcut icon" href={config.site.favicon} />
    <link rel="alternate" type="application/rss+xml" title={config.site.title} href={`${config.site.base_url}/rss.xml`} />
    <link rel="apple-touch-icon" href="/pwa/pwa-192x192.png" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <meta name="theme-name" content="astroplate" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    {/* Inline theme init — runs before stylesheets to avoid a post-paint class flip / forced reflow. */}
    <script is:inline define:vars={{ defaultTheme: config.settings?.default_theme ?? "system" }}>
      try {
        const stored = localStorage.getItem("theme");
        const sysDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const effective = stored || (defaultTheme === "system" ? (sysDark ? "dark" : "light") : defaultTheme);
        if (effective === "dark") document.documentElement.classList.add("dark");
      } catch {}
    </script>

    {import.meta.env.PROD && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-08V17G7ZDD"></script>
        <script is:inline>
          if (window.location.host === "villoro.com" || window.location.host === "www.villoro.com") {
            window.dataLayer = window.dataLayer || [];
            // eslint-disable-next-line prefer-rest-params
            function gtag(){window.dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-08V17G7ZDD');
          }
        </script>
      </>
    )}

    <!-- Fraunces (display) preloaded; Instrument Serif + JetBrains Mono async via display:optional -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;700&display=optional"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&display=swap" />
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;700&display=optional" />
    </noscript>

    <!-- Heebo + Signika via AstroFont -->
    <AstroFont
      config={[
        {
          src: fontSources("heebo", [400, 600], true),
          preload: false,
          display: "swap",
          name: fontPrimary!,
          fallback: "sans-serif",
          cssVariable: "font-primary",
        },
        {
          src: fontSources("signika", [500, 700]),
          preload: false,
          display: "optional",
          name: fontSecondary!,
          fallback: "sans-serif",
          cssVariable: "font-secondary",
        },
      ]}
    />

    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <title>{plainify(meta_title ? meta_title : title ? title : config.site.title)}</title>
    <link rel="canonical" href={resolvedCanonical} item-prop="url" />
    {prevHref && <link rel="prev" href={prevHref} />}
    {nextHref && <link rel="next" href={nextHref} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="description" content={plainify(description ? description : config.metadata.meta_description)} />
    <ClientRouter />
    <meta name="author" content={config.metadata.meta_author} />
    <meta property="og:title" content={plainify(meta_title ? meta_title : title ? title : config.site.title)} />
    <meta property="og:description" content={plainify(description ? description : config.metadata.meta_description)} />
    <meta property="og:type" content={ogType} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === "article" && author && (
      <meta property="article:author" content={author} />
    )}
    <meta property="og:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={plainify(meta_title ? meta_title : title ? title : config.site.title)} />
    <meta name="twitter:description" content={plainify(description ? description : config.metadata.meta_description)} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only">Skip to main content</a>
    <TwSizeIndicator />
    <SearchModal client:idle />
    <slot />
    <script>
      import { registerSW } from "virtual:pwa-register";
      registerSW({ immediate: true });
    </script>
  </body>
</html>
