---
interface Props {
  label: string;
  link: string;
  style?: string;
  rel?: string;
}

const { label, link, style, rel } = Astro.props;
const relExtra = rel ? (rel === "follow" ? "" : rel) : "nofollow";
---

<a
  href={link}
  target="_blank"
  rel={`noopener noreferrer ${relExtra}`}
  class={`btn mb-4 me-4 ${style === "outline" ? "btn-outline-primary" : "btn-primary"}`}
>{label}</a>
