---
/**
 * ArticleLayout — full-page layout for single blog posts.
 *
 * Structure:
 *   SiteNav
 *   Hero (16:9 image + gradient overlay + breadcrumb + category + title + tags + author meta)
 *   Article (260px sticky ArticleTOC + 1fr body slot)
 *   CTAStrip + ShareRow + GiscusComments
 *   RelatedPostsGrid
 *   SiteFooter
 *
 * The MDX <Content /> component goes into the default slot.
 *
 * Prose styles for the rendered MDX live in `src/styles/prose.css`, imported
 * below — applied globally so rehype-sectionize sections and shortcode output
 * pick them up. Imported here (not main.css) so they only ship on article pages.
 */
import BaseRedesign from "@/layouts/BaseRedesign.astro";
import "@/styles/prose.css";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ImageMod from "@/components/ImageMod.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ArticleTOC from "@/components/ArticleTOC.astro";
import CTAStrip from "@/components/CTAStrip.astro";
import ShareRow from "@/components/ShareRow.astro";
import RelatedPostsGrid from "@/components/RelatedPostsGrid.astro";
import GiscusComments from "@/components/GiscusComments.astro";
import { slugify } from "@/lib/utils/textConverter";
import { resolveImage } from "@/lib/utils/blogImages";
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { TocItem } from "@/components/ArticleTOC.astro";

interface Props {
  // SEO
  title: string;
  meta_title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;

  // Post metadata (for hero)
  category: string;
  catName: string;
  catColor: string;
  tags: string[];
  formattedDate: string;
  formattedUpdatedDate?: string;
  readTime: string;
  slug: string;
  blogFolder: string;

  // TOC
  toc: TocItem[];

  // Related posts
  relatedPosts: CollectionEntry<"blog">[];
}

const {
  title,
  meta_title,
  description,
  image,
  canonical,
  publishedTime,
  modifiedTime,
  author,
  category,
  catName,
  catColor,
  tags,
  formattedDate,
  formattedUpdatedDate,
  readTime,
  slug,
  blogFolder,
  toc,
  relatedPosts,
} = Astro.props;

const catSlug = slugify(category);

const breadcrumbs = [
  { href: "/",    label: "Villoro" },
  { href: "/blog", label: "Blog" },
  { href: `/categories/${catSlug}`, label: catName },
];

// Hero LCP preload — mirrors the Picture in ImageMod so the browser
// can start fetching the hero before parsing the body. Same widths +
// format are passed to the Picture below so the generated URLs match
// the preload's imagesrcset.
const heroWidths = [640, 1024, 1920];
const heroSizes = "(max-width: 640px) 640px, (max-width: 1024px) 1024px, 1920px";
let heroPreloadSrcset: string | null = null;
if (image) {
  const loader = resolveImage(image);
  if (loader) {
    const mod = await loader();
    const result = await getImage({
      src: mod.default,
      widths: heroWidths,
      format: "avif",
    });
    heroPreloadSrcset = result.srcSet.attribute;
  }
}
---

<BaseRedesign
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  canonical={canonical}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
>
  {heroPreloadSrcset && (
    <link
      slot="head"
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset={heroPreloadSrcset}
      imagesizes={heroSizes}
      fetchpriority="high"
    />
  )}
  <div class="al">
    <SiteNav />

    <!-- ═══════════════════════ HERO ════════════════════════ -->
    <section class="al-hero">
      {image && (
        <ImageMod
          src={image}
          alt={title}
          width={1920}
          height={1080}
          widths={heroWidths}
          sizes={heroSizes}
          loading="eager"
          fetchpriority="high"
          class="al-hero__img"
        />
      )}
      <div class="al-hero__overlay"></div>

      <Breadcrumb
        items={breadcrumbs}
        variant="light"
        class="al-hero__crumb"
      />

      <div class="al-hero__body">
        <span class="al-hero__cat" style={`background: ${catColor}`}>{catName}</span>
        <h1 class="al-hero__title">{title}</h1>

        {tags.length > 0 && (
          <div class="al-hero__tags">
            {tags.map((t: string) => (
              <a href={`/tags/${slugify(t)}`} class="al-hero__tag">#{t}</a>
            ))}
          </div>
        )}

        <div class="al-hero__meta">
          <span class="al-hero__author">Arnau Villoro</span>
          {formattedDate && (
            <><span class="al-hero__dot">·</span><span>{formattedDate}</span></>
          )}
          {formattedUpdatedDate && (
            <><span class="al-hero__dot">·</span><span>Updated {formattedUpdatedDate}</span></>
          )}
          {readTime && (
            <><span class="al-hero__dot">·</span><span>{readTime}</span></>
          )}
        </div>
      </div>
    </section>

    <!-- ═══════════════════ ARTICLE ═════════════════════════ -->
    <main class="al-article" id="main">
      {toc.length > 0 && <ArticleTOC toc={toc} />}

      <article class="al-body">
        <div class="article-content">
          <slot />
        </div>

        <CTAStrip />
        <ShareRow title={title} slug={slug} blogFolder={blogFolder} />
        <div class="al-comments">
          <GiscusComments />
        </div>
      </article>
    </main>

    <RelatedPostsGrid posts={relatedPosts} />
    <SiteFooter />
  </div>
</BaseRedesign>


<style>
  .al {
    background: var(--color-grey-50);
    color: var(--color-navy-900);
    font-family: var(--font-body);
    line-height: 1.6;
    --container-px: 64px;
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .al-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 620px;
    min-height: 420px;
    overflow: hidden;
    color: var(--color-on-dark);
    background: var(--color-surface-dark);
  }

  .al-hero :global(.al-hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .al-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(var(--color-surface-dark-rgb), 0.3)  0%,
      rgba(var(--color-surface-dark-rgb), 0.5)  55%,
      rgba(var(--color-surface-dark-rgb), 0.92) 100%
    );
  }

  /* Breadcrumb positioned top-left over the image */
  .al-hero :global(.al-hero__crumb) {
    position: absolute;
    top: 28px;
    left: var(--container-px);
    z-index: 3;
    font-size: 12px;
    gap: 10px;
  }

  .al-hero__body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 48px var(--container-px) 56px;
    max-width: 1440px;
    margin: 0 auto;
    z-index: 2;
  }

  .al-hero__cat {
    display: inline-block;
    color: var(--color-on-dark);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 6px;
    margin-bottom: 18px;
  }

  .al-hero__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(2.2rem, 5.5vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 1050px;
    text-wrap: balance;
    color: var(--color-on-dark);
  }

  .al-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .al-hero__tag {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-on-dark);
    padding: 5px 10px;
    background: rgba(255, 255, 255, 0.13);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    backdrop-filter: blur(4px);
    text-decoration: none;
    transition: background 0.15s;
  }
  .al-hero__tag:hover { background: rgba(255, 255, 255, 0.25); }

  .al-hero__meta {
    margin-top: 22px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--color-on-dark-body);
  }
  .al-hero__author { font-weight: 700; color: var(--color-on-dark); }
  .al-hero__dot    { opacity: 0.5; }

  /* ── Article 2-col grid ───────────────────────────────── */
  .al-article {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 72px;
    padding: 64px var(--container-px) 96px;
    align-items: start;
    max-width: 1280px;
    margin: 0 auto;
  }

  .al-body {
    max-width: 780px;
    min-width: 0;
  }

  .al-comments { padding: 8px 0 0; }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .al { --container-px: 32px; }
    .al-article {
      grid-template-columns: 1fr;
      gap: 0px;
      padding: 32px var(--container-px) 72px;
    }
    /* Remove the first heading's top margin — it immediately follows the TOC card */
    .al-body .article-content section:first-child > h2,
    .al-body .article-content > h2:first-child {
      margin-top: 0;
    }
  }

  @media (max-width: 767px) {
    .al { --container-px: 20px; }
    .al-hero { min-height: 340px; }
    .al-hero__body { padding: 28px var(--container-px) 32px; }
    .al-hero :global(.al-hero__crumb) { top: 16px; font-size: 11px; }
  }
</style>
